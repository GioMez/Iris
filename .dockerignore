# Only runtime inputs enter the build context.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!.npmrc
!LICENSE
!THIRD_PARTY_NOTICES.md
!src/
!src/**
!db/
!db/schema.sql
!public/
!public/**
# Exclude local material even when nested under a runtime directory.
**/.env
**/.env.*
**/.git
**/.drafts
**/.superpowers
**/node_modules
**/data
**/storage
**/*.log
**/*.tmp
**/*~
**/.DS_Store
**/*.pem
**/*.key
**/*.dump
