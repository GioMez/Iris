PORT=3000

# Required: generate a different random value for each secret.
IRIS_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=iris
DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
DB_NAME=iris
DB_CONNECT_TIMEOUT_MS=5000

DATA_DIR=./data/projects
PUBLIC_DIR=./public
TEX_BIN_PATH=
TEX_PATH_LOCKED=false
LILYPOND_BIN_PATH=
LILYPOND_PATH_LOCKED=false
COMPILE_TIMEOUT_MS=30000
COMPILE_LOG_LIMIT=1048576
COOKIE_SECURE=false
MAX_BODY_MB=25

# OAuth 2.0 / OIDC SSO, ad esempio Authentik.
# Con OAUTH_ISSUER_URL Iris usa la discovery .well-known/openid-configuration.
APP_BASE_URL=http://localhost:3000
OAUTH_ISSUER_URL=
# In alternativa alla discovery via issuer, puoi impostare gli endpoint esplicitamente.
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
OAUTH_SCOPE=openid email profile
OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
OAUTH_AUTO_REGISTER=false

# Password hashing, Argon2id. Valori opzionali; memoryCost e' in KiB.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
