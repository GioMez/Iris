# Iris configuration
# Copy this file to .env in the directory from which you start Iris.
# Native startup reads that file; existing process environment values take
# precedence. Restart Iris after changing startup settings.
# Use literal values: the native reader accepts quotes but does not expand
# shell variables. Put comments on separate lines. Booleans use true or false.
# Times ending in _MS are milliseconds (1000 = 1 second); _MB means MiB
# (1024 * 1024 bytes). Other units appear beside their settings below.
# Full reference: docs/configuration.md
#
# Docker/Podman Compose uses .env to substitute values in docker-compose.yml.
# It passes only the settings listed in webapp.environment to Iris. For other
# settings, add an environment entry there, e.g.:
#   RETENTION_AUDIT_DAYS: "${RETENTION_AUDIT_DAYS:-365}"
# The supplied Compose file fixes internal ports, database settings and data
# paths; changing their native values below does not override those entries.

# Network: process listener versus Compose host publication
# PORT is the HTTP port of the Iris process. For a native installation,
# PORT=8080 makes Iris listen on port 8080. Compose fixes this internal port
# at 3000; use IRIS_PORT to change the port you connect to on the host.
PORT=3000
# Compose only: host-side port. IRIS_PORT=8080 publishes host port 8080 to
# container port 3000, so local access uses http://localhost:8080.
IRIS_PORT=3000
# Compose only: host address on which to publish that port. 127.0.0.1 allows
# access from the host itself; 0.0.0.0 publishes on all host IPv4 interfaces.
# Use a specific host address to publish on one network interface.
IRIS_BIND_ADDRESS=127.0.0.1
# Address on which the Iris process listens. For native use, empty listens on
# all interfaces; 127.0.0.1 restricts access to this machine. A private or VPN
# address limits listening to that interface. In the supplied Compose setup,
# Iris listens on all container interfaces; restrict host exposure with
# IRIS_BIND_ADDRESS instead. An address binding does not authenticate clients.
BIND_ADDRESS=

# Session signing
# Required secret for signing sessions and OAuth state. Changing it invalidates
# existing signatures, so users must sign in again. This is not a DB password.
# Generate a separate random value for each secret/password, for example with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IRIS_SECRET=

# PostgreSQL
# Native connection settings: host, port, restricted application role and
# existing database. The supplied Compose file uses postgres:5432 with role
# iris and database iris, regardless of these native host/user/name values.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=iris
# Required password for DB_USER. Native use: match the role's existing password.
# Compose uses this on first initialization to create the iris role and passes
# it to the application. Editing .env does not change an existing DB password;
# update the database role's password as well when rotating it.
DB_PASSWORD=
# Compose only: required password for the PostgreSQL administrator (postgres)
# on first initialization. Iris does not receive it. Use a different value from
# DB_PASSWORD; changing it here does not reset an existing database password.
POSTGRES_ADMIN_PASSWORD=
DB_NAME=iris
# Maximum wait to establish a database connection: 5000 ms = 5 seconds.
DB_CONNECT_TIMEOUT_MS=5000

# Storage paths
# Relative paths resolve from Iris's working directory. In a container, paths
# refer to its filesystem. Compose stores /app/data in the project-data volume.
# Mutable project sources, outputs and server working data.
DATA_DIR=./data
# Shipped frontend files. Point this at the public directory from this release.
PUBLIC_DIR=./public
# Editable instance template catalog. If empty or omitted, uses DATA_DIR/templates.
# This example sets it explicitly: if you change DATA_DIR, update this line too,
# or leave it empty to follow DATA_DIR.
TEMPLATE_DIR=./data/templates

# Compilers
# Compiler paths must exist in Iris's own runtime. Install a toolchain compatible
# with that environment, its architecture and runtime dependencies.
# The lightweight container includes neither TeX nor LilyPond.
# Directory containing the TeX tools, not the path to a single executable.
# Empty uses PATH. For PDF/source navigation, make synctex available there too.
TEX_BIN_PATH=
# true prevents projects from overriding this directory. With an empty locked
# directory, Iris uses its own PATH rather than a project-supplied path.
TEX_PATH_LOCKED=false
# Directory containing lilypond; empty uses PATH.
LILYPOND_BIN_PATH=
# Same override policy as TEX_PATH_LOCKED, for LilyPond projects.
LILYPOND_PATH_LOCKED=false
# Timeout for each compiler step, not the whole multipass build. 30000 = 30 s.
COMPILE_TIMEOUT_MS=30000
# Captured compiler log limit per step and stored trace (1048576 = 1 MiB).
COMPILE_LOG_LIMIT=1048576

# Archives and transfers
# Build ZIP: total generated-file bytes before compression, and entry count.
# Entries include files and directories; these limits bound buffered exports.
BUILD_ARCHIVE_MAX_MB=128
BUILD_ARCHIVE_MAX_ENTRIES=10000
# Project export ZIP: total file bytes before compression, and entry count.
PROJECT_ARCHIVE_MAX_MB=256
PROJECT_ARCHIVE_MAX_ENTRIES=20000
# Maximum duration of a source-file download. Iris holds a project read lock
# during the transfer; this deadline bounds how long it can delay writes.
PROJECT_DOWNLOAD_TIMEOUT_MS=30000

# HTTPS and request handling
# true marks cookies Secure: browsers send them over HTTPS. Enable for HTTPS
# deployments, including TLS termination at a reverse proxy. This setting does
# not enable HTTPS on the Iris listener; leave false for local HTTP use.
COOKIE_SECURE=false
# Maximum JSON or project ZIP request body in MiB. ZIP import also limits the
# expanded contents to this size, with a fixed 10000-entry cap. Export limits
# above are separate: an exported ZIP may exceed another instance's import cap.
MAX_BODY_MB=25
# Public URL users visit, e.g. https://iris.example.com. Sets the expected origin
# for API writes and WebSocket connections, and the base for the SSO callback.
# Empty derives it from Host and the connection (or trusted forwarded headers).
# An explicit value takes precedence over forwarded host/protocol. Use an HTTP(S)
# URL without credentials, query or fragment. A path prefix also needs suitable
# proxy routing; setting this URL alone does not relocate Iris's routes.
APP_BASE_URL=
# true accepts proxy-provided client addresses for audit and rate limiting.
# When APP_BASE_URL is empty, also accepts the forwarded host and protocol.
# Enable only behind a trusted proxy that overwrites/strips X-Forwarded-For,
# X-Forwarded-Host and X-Forwarded-Proto. Forward one host and one protocol value;
# preserve browser Origin/Referer/Sec-Fetch-Site headers.
# Setup examples: docs/administration.md (Reverse proxy and HTTPS).
TRUST_PROXY=false

# Maintenance and shutdown
# Optional path override; defaults to DATA_DIR/.maintenance. Create that file
# to refuse new writes and drain active work for backup/restore. Reads continue.
# Remove the file to reopen writes; no restart needed to toggle maintenance.
# MAINTENANCE_FILE=./data/.maintenance
# Total graceful-shutdown budget after SIGTERM/SIGINT: realtime persistence,
# background work, direct compiler children and database closure. Timeout exits
# with code 1. A process manager/container stop grace period should exceed this.
SHUTDOWN_TIMEOUT_MS=15000

# Realtime collaboration
# Disk persistence and history revisions have separate timers. These settings
# accept positive integers; invalid values fall back to their defaults.
# Idle time before Iris writes accepted document edits to disk (2 seconds).
COLLAB_FLUSH_MS=2000
# Maximum interval before flushing while editing continues (15 seconds).
COLLAB_FLUSH_MAX_MS=15000
# Quiet time before consolidating edits into a history revision (2 minutes).
COLLAB_REVISION_IDLE_MS=120000
# Connection heartbeat and account revalidation interval (30 seconds).
COLLAB_HEARTBEAT_MS=30000
# Maximum collaboration message size in bytes (4 MiB).
COLLAB_MAX_MESSAGE_BYTES=4194304
# Browser batching delays for document edits and cursor movement. Larger values
# reduce message frequency but delay updates reaching collaborators. Local typing
# appears immediately. Iris serves these values to browsers through /api/config.
COLLAB_PUSH_DEBOUNCE_MS=300
COLLAB_PRESENCE_DEBOUNCE_MS=200
# Server broadcast intervals: collaborator cursor positions, then file-tree
# presence indicators. Larger intervals reduce broadcasts but delay indicators.
COLLAB_PEERS_TICK_MS=200
COLLAB_FILE_PRESENCE_TICK_MS=5000
# Interval for updating the project's "last modified" timestamp during editing.
# Iris groups updates per project to reduce database writes.
COLLAB_TOUCH_MS=30000
# Maximum document rooms per WebSocket connection. Each open room holds a whole
# document in server memory; raising this limit can increase memory use.
COLLAB_MAX_ROOMS_PER_SESSION=50
# Maximum simultaneous collaboration connections per account (e.g. browser tabs).
COLLAB_MAX_SESSIONS_PER_USER=12

# Rate limits and concurrency
# These limits apply to one Iris process and reset on restart. Use positive
# integers; zero, negative, fractional or invalid values use defaults. In
# particular, zero does not disable a queue. They do not cap total process memory.
# Rate allowances refill gradually over their _WINDOW_MS period, up to _LIMIT.
# Exhausted rate allowances return HTTP 429; full work queues return HTTP 503.
# Local login allowance per source IP, checked before reading the request body.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000
# Total allowance charged for a failed login, including the initial attempt.
AUTH_FAILURE_PENALTY=4
# Additional login allowance per submitted username/email, across source IPs.
# Iris trims and lowercases identifiers. Username and email have separate
# allowances even for the same account; a successful login clears both the
# submitted identifier's debt and the source IP's debt.
AUTH_ACCOUNT_RATE_LIMIT=12
AUTH_ACCOUNT_RATE_WINDOW_MS=900000
# Password hashing/verification operations running at once, then operations
# allowed to wait. Raising concurrency increases potential CPU and memory use;
# Argon2 cost settings appear at the end of this file.
PASSWORD_HASH_CONCURRENCY=2
PASSWORD_HASH_QUEUE=24
# Builds running at once across all users/projects, then builds allowed to wait
# in arrival order. A running slot covers setup through output publication and
# audit. Queued builds wait for a slot before saving or staging files.
COMPILE_CONCURRENCY=2
COMPILE_QUEUE=8
# Compile allowance per user/project pair, after checking project permissions.
COMPILE_RATE_LIMIT=30
COMPILE_RATE_WINDOW_MS=300000
# Authenticated API request allowance per account, shared across its sessions.
API_RATE_LIMIT=600
API_RATE_WINDOW_MS=60000

# Retention
# Iris prunes a build/revision only when it is BOTH outside the newest KEEP
# entries AND older than DAYS. For example, KEEP=20 and DAYS=30 protect the
# newest 20 builds and any build from the last 30 days. Running builds, the most
# recent successful build and the newest revision of each file are protected.
#
# KEEP/DAYS are instance defaults. Their _MAX counterparts limit what project
# owners may choose. A project without an override follows the current defaults.
# Iris clamps retention counts/days to supported ranges; see docs/configuration.md.
# false disables scheduled retention and interrupted-build reconciliation.
# Startup cleanup for confirmed project deletions still runs.
RETENTION_ENABLED=true
# Interval between cleanup sweeps (3600000 ms = 1 hour).
RETENTION_SWEEP_MS=3600000
# Build count per project: default, then owner's maximum.
RETENTION_BUILD_KEEP=20
RETENTION_BUILD_KEEP_MAX=200
# Build age in days: default, then owner's maximum.
RETENTION_BUILD_DAYS=30
RETENTION_BUILD_DAYS_MAX=365
# Revision count per file: default, then owner's maximum.
RETENTION_VERSION_KEEP=100
RETENTION_VERSION_KEEP_MAX=1000
# Revision age in days: default, then owner's maximum.
RETENTION_VERSION_DAYS=180
RETENTION_VERSION_DAYS_MAX=1095
# Instance-wide audit retention in days (minimum 90, maximum 36500). Audit
# cleanup uses age alone; project owners cannot override this setting.
RETENTION_AUDIT_DAYS=365
# Grace period before reclaiming abandoned staging/output directories after
# interrupted work (21600000 ms = 6 hours).
RETENTION_ORPHAN_GRACE_MS=21600000

# OAuth 2.0 / OpenID Connect single sign-on (SSO), e.g. Authentik
# Leave provider URLs and client credentials empty to keep SSO disabled.
# For SSO, register an application with your provider and supply its issuer URL,
# client ID and client secret. Compose users must also add these settings to
# webapp.environment; the commented examples there do not enable SSO.
# Setup: docs/administration.md (OpenID Connect).
# Provider issuer URL, used for discovery and durable account identity.
# Required for sign-in even when you supply the three endpoints below.
OAUTH_ISSUER_URL=
# Leave all three empty to discover endpoints via the issuer's
# .well-known/openid-configuration. Set all three to bypass discovery.
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
# Credentials issued by the identity provider for Iris's registered client.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Optional exact callback URL. Empty appends /api/auth/sso/callback to
# APP_BASE_URL, or to the derived request base URL when APP_BASE_URL is empty.
# Register that same callback URL with the provider.
OAUTH_REDIRECT_URI=
# Space-separated scopes requested from the provider.
OAUTH_SCOPE=openid email profile
# Token endpoint authentication: client_secret_basic sends HTTP Basic auth;
# client_secret_post sends credentials in the form body. Match your provider.
OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
# true creates an account for an SSO identity with no matching identity or email.
# false requires an existing account; see the guide for account linking rules.
OAUTH_AUTO_REGISTER=false
# Role for auto-created accounts: regular or external. admin is not allowed.
OAUTH_DEFAULT_ROLE=regular
# true makes auto-created accounts wait for administrator approval before access.
OAUTH_APPROVAL_REQUIRED=true

# Argon2id password hashing
# Cost parameters for new password hashes. Verification uses the parameters
# stored in each existing hash. Higher costs increase CPU/memory use; combine
# them with PASSWORD_HASH_CONCURRENCY to control simultaneous password work.
# Use positive integers; invalid values use defaults.
# Memory cost in KiB per new hash (65536 KiB = 64 MiB).
ARGON2_MEMORY_COST=65536
# Time cost (number of Argon2 passes).
ARGON2_TIME_COST=3
# Argon2 parallelism (number of lanes).
ARGON2_PARALLELISM=1
