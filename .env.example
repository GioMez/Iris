PORT=3000
# Interface to bind. Empty means every interface, which is what a container
# needs for its published port to reach the application. Set one address, such
# as a private or VPN interface, when Iris runs directly on a host whose other
# interfaces must not answer. This restricts who can connect, not who is
# trusted: a reverse proxy on another machine still needs a firewall or an
# encrypted link.
BIND_ADDRESS=

# Required session-signing secret. Generate a secure random value.
IRIS_SECRET=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=iris
# Required password for the restricted PostgreSQL user used by the application.
DB_PASSWORD=
# Required by Docker Compose for PostgreSQL initialization and administration.
# The application never receives this credential.
POSTGRES_ADMIN_PASSWORD=
DB_NAME=iris
DB_CONNECT_TIMEOUT_MS=5000

DATA_DIR=./data
PUBLIC_DIR=./public
# Mutable project-template catalog. Defaults to DATA_DIR/templates.
TEMPLATE_DIR=./data/templates
TEX_BIN_PATH=
TEX_PATH_LOCKED=false
LILYPOND_BIN_PATH=
LILYPOND_PATH_LOCKED=false
COMPILE_TIMEOUT_MS=30000
COMPILE_LOG_LIMIT=1048576
BUILD_ARCHIVE_MAX_MB=128
BUILD_ARCHIVE_MAX_ENTRIES=10000
PROJECT_ARCHIVE_MAX_MB=256
PROJECT_ARCHIVE_MAX_ENTRIES=20000
# Hard deadline for a source-file download while it holds the project read gate.
PROJECT_DOWNLOAD_TIMEOUT_MS=30000
COOKIE_SECURE=false
MAX_BODY_MB=25
# Enable only behind a reverse proxy that rewrites X-Forwarded-For, so that
# audit events record the client address instead of the proxy address.
TRUST_PROXY=false
# Creating this file puts Iris into maintenance mode without a restart: writes
# are refused, reads continue. Used to open a consistent backup/restore window.
# MAINTENANCE_FILE=./data/.maintenance
# Grace period for in-flight requests to finish on SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=15000

# Realtime collaboration. A document open in more than one browser is edited
# through the server, which writes it to disk after COLLAB_FLUSH_MS of quiet and
# at least every COLLAB_FLUSH_MAX_MS while typing continues. Bursts of live edits
# become one revision after COLLAB_REVISION_IDLE_MS.
COLLAB_FLUSH_MS=2000
COLLAB_FLUSH_MAX_MS=15000
COLLAB_REVISION_IDLE_MS=120000
COLLAB_HEARTBEAT_MS=30000
COLLAB_MAX_MESSAGE_BYTES=4194304
# How long a browser batches keystrokes and cursor moves before sending them.
# Typing stays instant locally whatever these are: they only pace how often the
# browser talks to the server. Served to the client through /api/config.
COLLAB_PUSH_DEBOUNCE_MS=300
COLLAB_PRESENCE_DEBOUNCE_MS=200
# Server-side coalescing, which is what makes a crowded document affordable.
# Answering each presence report individually is quadratic in the number of
# participants; answering on a tick is linear, and at this interval nobody can
# tell the difference. The file tree only reports whether somebody else is in a
# file, which never changes while anyone types, so it is paced far more slowly.
COLLAB_PEERS_TICK_MS=200
COLLAB_FILE_PRESENCE_TICK_MS=5000
# How often a project's "last modified" timestamp is written while its documents
# are being edited in realtime. Coalesced per project rather than per document,
# so many open files do not contend for one row.
COLLAB_TOUCH_MS=30000
# What one connection, and one account, may hold open. Each room keeps its whole
# document in memory for as long as somebody is in it.
COLLAB_MAX_ROOMS_PER_SESSION=50
COLLAB_MAX_SESSIONS_PER_USER=12

# Admission control. Each limit below bounds work a caller can make the server do
# before it knows whether the caller is entitled to it.
#
# Password verification is the sharpest edge: Argon2 spends ARGON2_MEMORY_COST
# KiB per attempt whether or not the password is right, so worst-case memory
# spent on password work is PASSWORD_HASH_CONCURRENCY x ARGON2_MEMORY_COST. The
# rate limits make an attack slow; the concurrency ceiling makes it survivable
# even when it is spread across too many sources to trip any rate limit.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_MS=60000
# A wrong password costs this many attempts' worth of allowance, so a guessing
# run exhausts its budget long before someone who mistyped once does.
AUTH_FAILURE_PENALTY=4
# Per account, independent of source address: this is what a distributed
# credential-stuffing run runs into.
AUTH_ACCOUNT_RATE_LIMIT=12
AUTH_ACCOUNT_RATE_WINDOW_MS=900000
PASSWORD_HASH_CONCURRENCY=2
PASSWORD_HASH_QUEUE=24
# Compilation spawns real compiler processes, so simultaneity is capped and the
# rest queue briefly. Raise COMPILE_CONCURRENCY on a machine with cores to spare.
COMPILE_CONCURRENCY=2
COMPILE_QUEUE=8
COMPILE_RATE_LIMIT=30
COMPILE_RATE_WINDOW_MS=300000
# A ceiling on authenticated API traffic per account. Far above what the editor
# generates; what it catches is a client stuck in a retry loop.
API_RATE_LIMIT=600
API_RATE_WINDOW_MS=60000

# Retention. A build or a revision is deleted only when it is BOTH outside the
# newest "keep" entries AND older than "days": either condition alone would
# either delete this morning's work on a busy day or empty the history of a
# project nobody has touched in a year.
#
# The values below are the instance defaults and the ceilings a project owner
# cannot exceed. A project that expresses no preference follows the default and
# keeps following it as you change it. The most recent successful build and the
# newest revision of every file are never pruned.
RETENTION_ENABLED=true
RETENTION_SWEEP_MS=3600000
RETENTION_BUILD_KEEP=20
RETENTION_BUILD_KEEP_MAX=200
RETENTION_BUILD_DAYS=30
RETENTION_BUILD_DAYS_MAX=365
RETENTION_VERSION_KEEP=100
RETENTION_VERSION_KEEP_MAX=1000
RETENTION_VERSION_DAYS=180
RETENTION_VERSION_DAYS_MAX=1095
# The audit trail is instance-wide and has no project owner, so this is not a
# per-project setting. The floor is 90 days: a trail that has already forgotten
# the incident is not a trail.
RETENTION_AUDIT_DAYS=365
# How long a directory abandoned by a crashed process is left alone before the
# sweep reclaims it. Long enough never to race a compilation that is merely slow.
RETENTION_ORPHAN_GRACE_MS=21600000

# OAuth 2.0 / OIDC SSO, for example Authentik.
# With OAUTH_ISSUER_URL, Iris uses .well-known/openid-configuration discovery.
APP_BASE_URL=http://localhost:3000
OAUTH_ISSUER_URL=
# As an alternative to issuer discovery, configure the endpoints explicitly.
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
OAUTH_SCOPE=openid email profile
OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
OAUTH_AUTO_REGISTER=false
# What an unknown SSO identity becomes when auto-registration is on. The role may
# be regular or external only (never admin), and approval is required by default:
# the account is created waiting for an administrator instead of getting in.
OAUTH_DEFAULT_ROLE=regular
OAUTH_APPROVAL_REQUIRED=true

# Argon2id password hashing. These values are optional; memory cost is in KiB.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
