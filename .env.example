PORT=3000
# Interface to bind. Empty means every interface, which is what a container
# needs for its published port to reach the application. Set one address, such
# as a private or VPN interface, when Iris runs directly on a host whose other
# interfaces must not answer. This restricts who can connect, not who is
# trusted: a reverse proxy on another machine still needs a firewall or an
# encrypted link.
BIND_ADDRESS=

# Required session-signing secret. Generate a secure random value.
IRIS_SECRET=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=iris
# Required password for the restricted PostgreSQL user used by the application.
DB_PASSWORD=
# Required by Docker Compose for PostgreSQL initialization and administration.
# The application never receives this credential.
POSTGRES_ADMIN_PASSWORD=
DB_NAME=iris
DB_CONNECT_TIMEOUT_MS=5000

DATA_DIR=./data
PUBLIC_DIR=./public
# Mutable project-template catalog. Defaults to DATA_DIR/templates.
TEMPLATE_DIR=./data/templates
TEX_BIN_PATH=
TEX_PATH_LOCKED=false
LILYPOND_BIN_PATH=
LILYPOND_PATH_LOCKED=false
COMPILE_TIMEOUT_MS=30000
COMPILE_LOG_LIMIT=1048576
BUILD_ARCHIVE_MAX_MB=128
BUILD_ARCHIVE_MAX_ENTRIES=10000
PROJECT_ARCHIVE_MAX_MB=256
PROJECT_ARCHIVE_MAX_ENTRIES=20000
COOKIE_SECURE=false
MAX_BODY_MB=25
# Enable only behind a reverse proxy that rewrites X-Forwarded-For, so that
# audit events record the client address instead of the proxy address.
TRUST_PROXY=false
# Creating this file puts Iris into maintenance mode without a restart: writes
# are refused, reads continue. Used to open a consistent backup/restore window.
# MAINTENANCE_FILE=./data/.maintenance
# Grace period for in-flight requests to finish on SIGTERM/SIGINT.
SHUTDOWN_TIMEOUT_MS=15000

# Realtime collaboration. A document open in more than one browser is edited
# through the server, which writes it to disk after COLLAB_FLUSH_MS of quiet and
# at least every COLLAB_FLUSH_MAX_MS while typing continues. Bursts of live edits
# become one revision after COLLAB_REVISION_IDLE_MS.
COLLAB_FLUSH_MS=2000
COLLAB_FLUSH_MAX_MS=15000
COLLAB_REVISION_IDLE_MS=120000
COLLAB_HEARTBEAT_MS=30000
COLLAB_MAX_MESSAGE_BYTES=4194304
# How long a browser batches keystrokes and cursor moves before sending them.
# Typing stays instant locally whatever these are: they only pace how often the
# browser talks to the server. Served to the client through /api/config.
COLLAB_PUSH_DEBOUNCE_MS=300
COLLAB_PRESENCE_DEBOUNCE_MS=200

# OAuth 2.0 / OIDC SSO, for example Authentik.
# With OAUTH_ISSUER_URL, Iris uses .well-known/openid-configuration discovery.
APP_BASE_URL=http://localhost:3000
OAUTH_ISSUER_URL=
# As an alternative to issuer discovery, configure the endpoints explicitly.
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
OAUTH_SCOPE=openid email profile
OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
OAUTH_AUTO_REGISTER=false
# What an unknown SSO identity becomes when auto-registration is on. The role may
# be regular or external only (never admin), and approval is required by default:
# the account is created waiting for an administrator instead of getting in.
OAUTH_DEFAULT_ROLE=regular
OAUTH_APPROVAL_REQUIRED=true

# Argon2id password hashing. These values are optional; memory cost is in KiB.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
